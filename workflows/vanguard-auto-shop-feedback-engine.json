    {
      "parameters": {
        "sendTo": "={{ $json.customer_email }}",
        "subject": "=How Was Your Visit,{{ $json.customer_name }}?",
        "message": "=<!-- Vanguard Auto Shop - premium customer feedback email for n8n Gmail HTML -->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0;padding:0;background:#f1efeb;font-family:Arial,Helvetica,sans-serif;color:#20252b;\">\n  <tr>\n    <td align=\"center\" style=\"padding:24px 12px;background:#f1efeb;\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:620px;background:#ffffff;overflow:hidden;\">\n\n        <tr>\n          <td style=\"height:5px;background:#f05a24;font-size:0;line-height:0;\">&nbsp;</td>\n        </tr>\n\n        <!-- Brand Header -->\n        <tr>\n          <td style=\"padding:28px 34px 26px;background:#17191c;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n              <tr>\n                <td valign=\"middle\" style=\"width:220px;\">\n                  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                    <tr>\n                      <td valign=\"middle\" style=\"color:#f05a24;font-family:'Arial Black','Trebuchet MS',Arial,Helvetica,sans-serif;font-size:30px;line-height:32px;font-weight:900;font-style:italic;letter-spacing:-1px;text-shadow:2px 2px 0 #8f2e16;\">VANGUARD</td>\n                      <td valign=\"bottom\" style=\"padding:0 0 4px 10px;color:#f6f2eb;font-size:9px;line-height:1.1;font-weight:700;letter-spacing:2.3px;\">AUTO<br>SHOP</td>\n                    </tr>\n                  </table>\n                </td>\n                <td valign=\"middle\" align=\"right\" style=\"color:#9da2a5;font-size:10px;line-height:1.7;font-weight:700;letter-spacing:1.7px;text-transform:uppercase;\">SERVICE<br>TRUST<br>PERFORMANCE</td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- Hero -->\n        <tr>\n          <td style=\"padding:51px 52px 45px;background:#fbf7f0;border-bottom:1px solid #e9e1d7;text-align:center;\">\n            <div style=\"color:#f05a24;font-size:10px;line-height:1.4;font-weight:700;letter-spacing:2.8px;text-transform:uppercase;\">CUSTOMER EXPERIENCE / 01</div>\n            <h1 style=\"margin:18px 0;color:#20252b;font-family:Georgia,'Times New Roman',serif;font-size:38px;line-height:1.08;font-weight:700;letter-spacing:-.8px;\">Your experience<br>drives our standard.</h1>\n            <p style=\"max-width:430px;margin:0 auto;color:#5d6469;font-size:16px;line-height:1.7;\">We'd love to hear how your visit went. Your honest feedback helps Vanguard Auto Shop make every service better.</p>\n          </td>\n        </tr>\n\n        <!-- Message -->\n        <tr>\n          <td style=\"padding:37px 52px 29px;background:#ffffff;\">\n            <p style=\"margin:0;color:#252a2e;font-size:16px;line-height:1.75;\">Dear <strong>{{ $json.customer_name }}</strong>,</p>\n            <p style=\"margin:17px 0 0;color:#5d6469;font-size:15px;line-height:1.78;\">Thank you for trusting us with your vehicle. We want to make sure your <strong style=\"color:#20252b;\">{{ $json.service_type }}</strong> visit at our <strong style=\"color:#20252b;\">{{ $json.branch_location }}</strong> branch matched the Vanguard standard.</p>\n          </td>\n        </tr>\n\n        <!-- Service Details -->\n        <tr>\n          <td style=\"padding:0 52px 31px;background:#ffffff;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-top:1px solid #e9e1d7;border-bottom:1px solid #e9e1d7;\">\n              <tr>\n                <td width=\"50%\" valign=\"top\" style=\"padding:18px 16px 18px 0;border-right:1px solid #e9e1d7;\">\n                  <div style=\"color:#f05a24;font-size:9px;line-height:1.4;font-weight:700;letter-spacing:1.9px;text-transform:uppercase;\">SERVICE</div>\n                  <div style=\"margin-top:7px;color:#20252b;font-family:Georgia,'Times New Roman',serif;font-size:17px;line-height:1.3;font-weight:700;\">{{ $json.service_type }}</div>\n                </td>\n                <td width=\"50%\" valign=\"top\" style=\"padding:18px 0 18px 16px;\">\n                  <div style=\"color:#f05a24;font-size:9px;line-height:1.4;font-weight:700;letter-spacing:1.9px;text-transform:uppercase;\">LOCATION</div>\n                  <div style=\"margin-top:7px;color:#20252b;font-family:Georgia,'Times New Roman',serif;font-size:17px;line-height:1.3;font-weight:700;\">{{ $json.branch_location }}</div>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- Feedback Button -->\n        <tr>\n          <td style=\"padding:5px 52px 43px;background:#ffffff;text-align:center;\">\n            <a href=\"{{ 'https://forms.fillout.com/t/YOUR_FORM_ID?JOBID=' + encodeURIComponent($json.id) }}\" style=\"display:inline-block;padding:16px 30px;background:#f05a24;color:#ffffff;border-radius:3px;font-size:14px;line-height:1.2;font-weight:700;letter-spacing:.2px;text-align:center;text-decoration:none;\">Share Your Feedback &nbsp;→</a>\n            <div style=\"margin-top:15px;color:#8a8f92;font-size:11px;line-height:1.6;\">Takes less than a minute&nbsp; · &nbsp;No login required</div>\n          </td>\n        </tr>\n\n        <!-- Footer -->\n        <tr>\n          <td style=\"padding:27px 34px 30px;background:#17191c;color:#aeb2b3;font-size:11px;line-height:1.8;\">\n            <strong style=\"color:#f6f2eb;font-family:Georgia,'Times New Roman',serif;font-size:16px;letter-spacing:.2px;\">VANGUARD AUTO SHOP</strong>\n            <br>Service · Trust · Performance\n            <br><span style=\"color:#f05a24;\">Thank you for helping us keep the standard high.</span>\n          </td>\n        </tr>\n\n      </table>\n    </td>\n  </tr>\n</table>",
        "options": {
          "appendAttribution": false
        }
      },
